# Clínica Favmed - Medicina Ocupacional | configuração local
# Copie este arquivo para .env e preencha os valores no ambiente privado.
# Nunca publique o arquivo .env nem compartilhe tokens reais.

# Token privado para autorizar clientes MCP (obrigatório para usar /mcp).
# Gere uma sequência longa e aleatória e configure o mesmo valor no cliente.
MCP_AUTH_TOKEN=

# Credenciais fornecidas pelo administrador da API Quarks.
QUARKS_API_TOKEN=
QUARKS_CHAVE_KEY=
QUARKS_SECRET_KEY=

# URL oficial da API; altere somente se a Quarks fornecer outra URL.
QUARKS_API_URL=https://api.quark.tec.br/clinic/ext/v1

# Tempo máximo de espera pela API, entre 1000 e 60000 milissegundos.
QUARKS_API_TIMEOUT_MS=15000

# Origens web autorizadas separadas por vírgula. Vazio desativa CORS.
# CORS_ORIGINS=http://localhost:3000
