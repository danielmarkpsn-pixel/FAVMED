# Configuração do MCP Quarks Agendamentos

# Token de autenticação (OBRIGATÓRIO)
QUARKS_API_TOKEN=FAVMEDSYSTEM

# Chaves adicionais para operações de modificação (RECOMENDADO)
# Necessário para: criar_agendamento, cancelar_agendamento, confirmar_agendamento
QUARKS_CHAVE_KEY=FAVMED1
QUARKS_SECRET_KEY=FAVMED2

# URL da API (OPCIONAL - já tem valor padrão)
# QUARKS_API_URL=https://api.quark.tec.br/clinic/ext/v1
